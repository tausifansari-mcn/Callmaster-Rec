# Base URL of the API as seen by the browser.
#  - "/api"  works in development (Vite proxies it) and when the backend serves the built site (SERVE_FRONTEND=true)
#  - use the full URL (e.g. https://api.yourdomain.com/api) when the site and API are on different domains
VITE_API_BASE_URL=/api
# Development only: where the Vite dev server forwards /api requests
VITE_DEV_API_PROXY=http://localhost:5100
