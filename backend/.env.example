# =====================================================================
#  CallMaster backend — copy this file to ".env" and fill in the values
# =====================================================================

# ---- Server ----------------------------------------------------------
NODE_ENV=development
PORT=5100
# Public address of the website — used for the login link in the customer welcome email.
PUBLIC_SITE_URL=http://localhost:5173
# Comma-separated list of front-end origins allowed to call the API (only needed if the site is
# hosted on a different domain than the API). Example: https://www.yourdomain.com,https://yourdomain.com
CORS_ORIGINS=http://localhost:5173
# Set true when running behind a proxy/load balancer (Nginx, Render, Heroku, ...)
TRUST_PROXY=false
# Serve the built React app (../frontend/dist) from this same server — handy for single-server deploys
SERVE_FRONTEND=false

# ---- Database (MySQL) --------------------------------------------------
# The API uses the database named below (db_masmin) and creates all tables in it automatically on start-up
# (schema: backend/database/schema.sql). If the MySQL user is allowed to, it also creates the database itself.
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=db_masmin
# Set true for cloud databases that require TLS
DB_SSL=false
# Create the tables on start-up (safe to leave on: it only adds what is missing)
DB_AUTO_MIGRATE=true
DB_CONNECTION_LIMIT=10

# ---- Security --------------------------------------------------------
# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# ---- First admin account ---------------------------------------------
# Created automatically on first start when no admin exists yet. Change the password after logging in,
# then you can blank these two lines. (Extra admins can be added from the admin panel.)
ADMIN_NAME=Site Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Sandbox / payments ------------------------------------------------
# true  = OTP codes are shown on screen (no email/SMS provider needed) — for testing only
# false = OTPs are only delivered by email (SMTP below) / SMS (SMS_WEBHOOK_URL). Use false in production.
SANDBOX_MODE=true
# sandbox  = simulated Razorpay popup (no real money)
# razorpay = real Razorpay Checkout; needs the two keys below
PAYMENT_MODE=sandbox
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# One free Voice Bot demo call per phone number. Set false while testing to allow repeats.
DEMO_LIMIT_ENABLED=true

# ---- Email (SMTP) — OTP codes, order receipts, sales notifications ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CallMaster <no-reply@yourdomain.com>
# Inbox that gets a heads-up for every new order / lead / contact message / demo
NOTIFY_EMAIL=

# ---- Optional integrations --------------------------------------------
# POST {"to","message"} target used to text the Voice Bot demo OTP (any SMS gateway / Zapier / internal service)
SMS_WEBHOOK_URL=
# POST target that receives the Voice Bot demo call request (your telephony / voice-bot platform)
VOICE_DEMO_WEBHOOK_URL=

# ---- Uploads & retention ------------------------------------------------
UPLOAD_DIR=uploads
UPLOAD_MAX_MB=25
# Demo audio older than this is deleted automatically (matches the published Data Retention Policy)
DATA_RETENTION_DAYS=30

# ---- Deep Customer Insights (real call audit) ------------------------------
# Deepgram turns the uploaded recording into a speaker-labelled transcript; Claude (Anthropic) then audits the
# transcript against the rubric for the selected line of business. Without both keys the demo falls back to the
# original randomised sandbox scorecard. Keys stay on the server — they are never sent to the browser.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Abuse guard: max audit uploads per email address per 24 h (0 = unlimited). Each one costs API credits.
AUDIT_MAX_PER_EMAIL_DAY=3
